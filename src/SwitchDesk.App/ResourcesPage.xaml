<UserControl x:Class="SwitchDesk.App.ResourcesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource Text}" SizeChanged="OnPageSizeChanged">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8">
   <DockPanel>
    <Button x:Name="CancelResourceSearchButton" Content="取消搜索" Command="{Binding Commands[ResourceCancelSearch]}" DockPanel.Dock="Right" Margin="10,0,0,0" Visibility="{Binding Resources.IsBusy,Converter={StaticResource Visible}}"/>
    <Button x:Name="SearchResourcesButton" Content="搜索资源" Command="{Binding Commands[ResourceSearch]}" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="10,0,0,0"/>
    <TextBox x:Name="ResourceSearchBox" Text="{Binding Resources.SearchText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchField}" Tag="搜索游戏、工具或金手指"
     PreviewKeyDown="OnSearchKeyDown" AutomationProperties.Name="搜索资源名称" ToolTip="搜索游戏、Homebrew、金手指或插件 · Ctrl+F"/>
   </DockPanel>
   <WrapPanel Margin="0,8,0,0">
    <TextBlock Text="来源" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,6"/>
    <ComboBox ItemsSource="{Binding Resources.Sources}" SelectedItem="{Binding Resources.SelectedSource}" DisplayMemberPath="Label" Width="190" AutomationProperties.Name="资源来源" Margin="0,0,16,6"/>
    <TextBlock Text="类型" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,6"/>
    <ComboBox ItemsSource="{Binding Resources.Types}" SelectedItem="{Binding Resources.SelectedType}" Width="130" AutomationProperties.Name="资源类型筛选" Margin="0,0,16,6"/>
    <TextBlock Text="{Binding Resources.Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,6" MaxWidth="460" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Resources.Status}"/>
   </WrapPanel>
   <ProgressBar IsIndeterminate="True" Visibility="{Binding Resources.IsBusy,Converter={StaticResource Visible}}" Margin="0,2,0,0"/>
  </StackPanel>
  <Expander x:Name="ResourceOptions" Grid.Row="1" Header="添加资源与更多搜索选项" IsExpanded="True" Margin="0,0,0,10">
   <ScrollViewer x:Name="ResourceOptionsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="155">
    <StackPanel Margin="0,8,8,0">
     <TextBlock Text="文件先下载到电脑，安装前再核对来源、游戏与版本。" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
     <WrapPanel>
      <Button Content="从直链添加…" Command="{Binding Commands[ResourceAddLink]}" Margin="0,0,8,8"/>
      <Button Content="导入 JSON 索引…" Command="{Binding Commands[ResourceImportIndex]}" Margin="0,0,8,8"/>
      <Button Content="配置游戏来源…" Command="{Binding Commands[AddContentSource]}" Margin="0,0,8,8"/>
      <Button Content="打开下载目录" Command="{Binding Commands[ResourceOpenDirectory]}" Margin="0,0,0,8"/>
     </WrapPanel>
     <WrapPanel Visibility="{Binding Resources.IsPublicSite,Converter={StaticResource Visible}}">
      <Button Content="浏览器站内搜索 ↗" Command="{Binding Commands[ResourceSearchWeb]}" Margin="0,0,8,8"/>
      <Button Content="搜索公开索引 ↗" Command="{Binding Commands[ResourceSearchIndex]}" Margin="0,0,8,8" ToolTip="用 Bing 查询所选网站已收录的公开文章；可能与站内结果不同"/>
      <Button Content="官方公告 ↗" Command="{Binding Commands[ResourceSiteNotice]}" Visibility="{Binding Resources.IsNstSite,Converter={StaticResource Visible}}" Margin="0,0,8,8"/>
     </WrapPanel>
    </StackPanel>
   </ScrollViewer>
  </Expander>  <TabControl Grid.Row="2" SelectedIndex="{Binding Resources.SelectedTab}">
   <TabItem Header="资源结果">
    <Grid Margin="0,12,0,0">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid>
      <ListBox x:Name="ResourceResults" ItemsSource="{Binding Resources.Results}" SelectedItem="{Binding Resources.SelectedResult}" AutomationProperties.Name="资源搜索结果">
       <ListBox.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,14" Margin="0,0,0,4">
         <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Metadata}" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,6,0,0" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Availability}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
         </StackPanel>
        </Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430" Margin="20" Visibility="{Binding Resources.Empty,Converter={StaticResource Visible}}">
       <TextBlock Text="{Binding Resources.EmptyHeading}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
       <TextBlock Text="{Binding Resources.EmptyDescription}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,0"/>
      </StackPanel>
     </Grid>
     <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
      <StackPanel>
       <WrapPanel>
        <Button Content="下载所选到电脑" Style="{StaticResource Primary}" Command="{Binding Commands[ResourceDownload]}" Margin="0,0,8,8"/>
        <Button Content="查看原站 ↗" Command="{Binding Commands[ResourceOpenSite]}" Margin="0,0,8,8"/>
       </WrapPanel>
       <TextBlock Text="{Binding Resources.SelectionHint}" Style="{StaticResource Muted}"/>
      </StackPanel>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="已下载">
    <Grid Margin="0,12,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10">
      <Button Content="刷新下载记录" Command="{Binding Commands[ResourceRefreshDownloads]}" DockPanel.Dock="Right"/>
      <TextBlock Text="{Binding Resources.DownloadCountText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
     </DockPanel>
     <Grid Grid.Row="1">
      <ListBox x:Name="ResourceDownloads" ItemsSource="{Binding Resources.Downloads}" SelectedItem="{Binding Resources.SelectedDownload}" AutomationProperties.Name="已下载的资源">
       <ListBox.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,14" Margin="0,0,0,4">
         <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Metadata}" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding Status}" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding FileName}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
         </StackPanel>
        </Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430" Margin="20" Visibility="{Binding Resources.DownloadsEmpty,Converter={StaticResource Visible}}">
       <TextBlock Text="还没有下载记录" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
       <TextBlock Text="添加直链或导入索引后，选择资源下载。下载完成后在这里核对并选择安装。" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,0"/>
      </StackPanel>
     </Grid>
     <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
      <StackPanel>
       <WrapPanel>
        <Button Content="核对并安装所选…" Style="{StaticResource Primary}" Command="{Binding Commands[ResourceInstall]}" Margin="0,0,8,8"/>
        <Button Content="打开所选位置" Command="{Binding Commands[ResourceReveal]}" Margin="0,0,8,8"/>
        <Button Content="补充金手指标识…" Command="{Binding Commands[ResourceEditIdentity]}" Margin="0,0,8,8"/>
       </WrapPanel>
       <TextBlock Text="{Binding Resources.DownloadSelectionHint}" Style="{StaticResource Muted}"/>
      </StackPanel>
     </Border>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
