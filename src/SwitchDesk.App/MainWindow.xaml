<Window x:Class="SwitchDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SwitchDesk.App" Title="SwitchDesk" Width="1280" Height="820" MinWidth="1050" MinHeight="640" Style="{StaticResource {x:Type Window}}" Loaded="OnLoaded" Closing="OnClosing" SizeChanged="OnWindowSize" PreviewKeyDown="OnWindowKey">
<Window.Resources>
 <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource Quiet}">
  <Setter Property="Foreground" Value="{DynamicResource RailMuted}"/><Setter Property="Background" Value="{DynamicResource Rail}"/><Setter Property="Padding" Value="8,9"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource RailSelected}" BorderThickness="0"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value=".85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="GameCard">
  <Button Width="{Binding Width,Mode=OneWay}" Margin="0,0,16,18" Padding="0" BorderThickness="0" Background="Transparent" Command="{Binding DataContext.Commands[SelectGame],RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Loaded="OnCardLoaded" AutomationProperties.Name="{Binding Name,Mode=OneWay}">
   <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Card" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource Line}" Padding="2" Background="{DynamicResource Surface}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover}"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource Selected}"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
   <StackPanel>
    <Border Background="{DynamicResource Subtle}" CornerRadius="10" Height="{Binding ArtSize,Mode=OneWay}" ClipToBounds="True"><Grid>
     <TextBlock Text="{Binding Initial}" FontSize="44" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
     <Border Background="#D91B1D1C" CornerRadius="6" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"><TextBlock Text="{Binding Source}" Foreground="#FFF7EF" FontSize="10" TextWrapping="NoWrap"/></Border>
     <Border Background="{DynamicResource Accent}" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Visibility="{Binding IsSelected,Converter={StaticResource Visible}}"><TextBlock Text="✓" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid></Border>
    <StackPanel Margin="8,10,8,10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,7,0,0"><TextBlock Text="{Binding SizeText}" Style="{StaticResource Muted}" DockPanel.Dock="Right" FontSize="11"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/></DockPanel></StackPanel>
   </StackPanel>
  </Button>
 </DataTemplate>
</Window.Resources>
<Grid x:Name="Root" Background="{DynamicResource Canvas}">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="208"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
 <!-- Console and persistent navigation -->
 <Border x:Name="Sidebar" Grid.RowSpan="3" Background="{DynamicResource Rail}">
  <Grid Margin="14,22,14,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="4,0,0,22"><Image Source="pack://application:,,,/SwitchDesk;component/Assets/SwitchDesk.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock x:Name="BrandLabel" Text="SwitchDesk" Foreground="{DynamicResource RailText}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
   <Border Grid.Row="1" Background="{DynamicResource RailSurface}" CornerRadius="12" Padding="10" Margin="0,0,0,18" ToolTip="{Binding Connection}"><StackPanel>
    <TextBlock x:Name="ConsoleLabel" Text="{Binding Model}" Foreground="{DynamicResource RailText}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
    <DockPanel><TextBlock Text="●" FontSize="9" VerticalAlignment="Top" Margin="0,3,6,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource RailMuted}"/><Style.Triggers><DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel x:Name="ConsoleStatusLabels"><TextBlock Text="{Binding Connection}" Foreground="{DynamicResource RailMuted}" FontSize="11"/><TextBlock Text="{Binding EnvironmentText}" Foreground="{DynamicResource RailMuted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DockPanel>
   </StackPanel></Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock x:Name="WorkspaceLabel" Text="我的工作空间" Foreground="{DynamicResource RailMuted}" FontSize="10" Margin="10,0,0,10"/>
    <ItemsControl ItemsSource="{Binding Navigation}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource RailButton}" Command="{Binding DataContext.Commands[Navigate],RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" ToolTip="{Binding Label}" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="24"/><TextBlock Text="{Binding Label}" FontSize="13" Margin="10,0,0,0" Visibility="{Binding DataContext.Compact,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Visible},ConverterParameter=not}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="3">
    <StackPanel x:Name="RailCapacity" Margin="10,8,10,14" Visibility="{Binding ShowRailStorage,Converter={StaticResource Visible}}"><TextBlock Text="SD 卡空间" Foreground="{DynamicResource RailMuted}" FontSize="10"/><ProgressBar Value="{Binding SdStorage.UsedPercent,Mode=OneWay}" Background="{DynamicResource RailSurface}" Foreground="{DynamicResource RailSelected}" Height="3" Margin="0,8,0,7"/><TextBlock Text="{Binding SdStorage.Summary}" Foreground="{DynamicResource RailMuted}" FontSize="10"/></StackPanel>
    <Button ToolTip="设置" AutomationProperties.Name="设置" Style="{StaticResource RailButton}" Command="{Binding Commands[Navigate]}" CommandParameter="settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="24"/><TextBlock Text="设置" Margin="10,0,0,0" FontSize="13" Visibility="{Binding Compact,Converter={StaticResource Visible},ConverterParameter=not}"/></StackPanel></Button>
    <Button ToolTip="连接诊断" AutomationProperties.Name="连接诊断" Style="{StaticResource RailButton}" Command="{Binding Commands[Navigate]}" CommandParameter="diagnostics"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Width="24"/><TextBlock Text="连接诊断" Margin="10,0,0,0" FontSize="13" Visibility="{Binding Compact,Converter={StaticResource Visible},ConverterParameter=not}"/></StackPanel></Button>
    <Border BorderBrush="{DynamicResource RailLine}" BorderThickness="0,1,0,0" Padding="8,14,0,0" Margin="0,12,0,0" Visibility="{Binding Compact,Converter={StaticResource Visible},ConverterParameter=not}"><StackPanel><TextBlock Text="一生破晓" Foreground="{DynamicResource RailText}" FontWeight="SemiBold"/><TextBlock Text="让每次游玩，都有归处。" Foreground="{DynamicResource RailMuted}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
    <TextBlock x:Name="VersionLabel" Text="SwitchDesk" Foreground="{DynamicResource RailMuted}" FontSize="10" Margin="8,9,0,0"/>
   </StackPanel>
  </Grid>
 </Border> <Border Grid.Column="1" Grid.ColumnSpan="2" Margin="20,18,20,18" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16"><Grid Margin="20,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="画面预览 ↗" Style="{StaticResource Quiet}" Command="{Binding Commands[StreamGuide]}" Margin="0,0,14,0"/><StackPanel Orientation="Horizontal" Margin="0,0,10,0"><Button x:Name="HeaderDbi" Content="通过 DBI 安装" Style="{StaticResource Primary}" Command="{Binding Commands[DbiInstall]}"/><Button x:Name="HeaderDbiLaunch" Content="在主机打开 DBI" ToolTipService.ShowOnDisabled="True" ToolTip="连接支持 dbi.launch.v1 的 SwitchDesk 配套后，可打开主机已安装的 DBI。" Margin="4,0,0,0" Padding="8,6" Command="{Binding Commands[DbiLaunch]}"/></StackPanel><Button x:Name="HeaderInstall" Content="SwitchDesk 安装" Command="{Binding Commands[InstallPick]}"/></StackPanel><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PageTitle,Mode=OneWay}" Style="{StaticResource Heading}"/><Border Background="{DynamicResource Selected}" CornerRadius="6" Padding="7,3" Margin="12,2,0,8" VerticalAlignment="Center"><TextBlock Text="破晓" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold"/></Border></StackPanel><TextBlock Text="{Binding SyncText,Mode=OneWay}" Style="{StaticResource Muted}"/></StackPanel></DockPanel>
  <Grid x:Name="SearchHeader" Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Style="{StaticResource SearchField}" Text="{Binding Library.Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索游戏名称或标识" ToolTip="搜索游戏 · Ctrl+F"/><Button Grid.Column="1" Content="电脑游戏目录" Margin="12,0,0,0" Command="{Binding Commands[AddLibrary]}"/></Grid>
 </Grid></Border>
 <!-- Page shell -->
 <Grid Grid.Row="1" Grid.Column="1" Margin="28,0,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="1" x:Name="FixtureBanner" Visibility="{Binding Fixture,Converter={StaticResource Visible}}" Background="{DynamicResource Selected}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"><TextBlock Text="界面测试数据 · 500 项夹具 · 非实机游戏或连接" FontSize="12"/></Border>
  <Border Grid.Row="2" x:Name="NoticeBox" Background="{DynamicResource Selected}" CornerRadius="7" Padding="12" Margin="0,0,0,12"><DockPanel><Button Content="×" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Padding="8,0" MinHeight="24" Command="{Binding Commands[Dismiss]}"/><Button x:Name="NoticeOpen" Content="打开位置" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Padding="8,0" MinHeight="24" Command="{Binding Commands[NoticeOpen]}"/><TextBlock Text="{Binding Notice,Mode=OneWay}" VerticalAlignment="Center"/></DockPanel></Border>
  <Grid Grid.Row="3">
   <!-- Game library -->
   <Grid x:Name="LibraryPage" SizeChanged="OnGallerySize"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="1" Margin="0,0,0,16"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="GridViewButton" Content="&#xE80A;" FontFamily="Segoe MDL2 Assets" ToolTip="封面网格" Padding="10,4" MinHeight="30" Command="{Binding Commands[Grid]}"/><Button x:Name="ListViewButton" Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" ToolTip="列表" Padding="10,4" MinHeight="30" Margin="6,0,0,0" Command="{Binding Commands[List]}"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="全部" Command="{Binding Commands[Source]}" CommandParameter="全部" Style="{StaticResource Quiet}" Padding="10,4" MinHeight="30"/><Button Content="主机" Command="{Binding Commands[Source]}" CommandParameter="主机" Style="{StaticResource Quiet}" Padding="10,4" MinHeight="30"/><Button Content="电脑" Command="{Binding Commands[Source]}" CommandParameter="电脑" Style="{StaticResource Quiet}" Padding="10,4" MinHeight="30"/><ComboBox SelectedValue="{Binding Library.StatusFilter}" SelectedValuePath="Content" Width="112" Margin="8,0,0,0" AutomationProperties.Name="按更新和隐藏状态筛选"><ComboBoxItem Content="全部状态"/><ComboBoxItem Content="有更新"/><ComboBoxItem Content="已隐藏" IsEnabled="False" ToolTip="原生 HOME 精选功能尚未准入"/></ComboBox><TextBlock Text="{Binding Library.CountText,Mode=OneWay}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></DockPanel>
    <Grid Grid.Row="2" AllowDrop="True" DragOver="OnInstallDragOver" Drop="OnInstallDrop">
     <ListBox x:Name="Gallery" ItemsSource="{Binding Library.Rows,Mode=OneWay}" Visibility="{Binding Library.ListView,Converter={StaticResource Visible},ConverterParameter=not}" PreviewKeyDown="OnGalleryKey" KeyboardNavigation.TabNavigation="Once"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Cards,Mode=OneWay}" ItemTemplate="{StaticResource GameCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></DataTemplate></ListBox.ItemTemplate></ListBox>
     <DataGrid x:Name="GamesGrid" ItemsSource="{Binding Library.Filtered,Mode=OneWay}" SelectedItem="{Binding Library.Selected,Mode=OneWay}" SelectionChanged="OnGameSelection" Visibility="{Binding Library.ListView,Converter={StaticResource Visible}}"><DataGrid.Columns><DataGridTextColumn Header="游戏" Binding="{Binding Name,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="来源" Binding="{Binding Source,Mode=OneWay}" Width="100"/><DataGridTextColumn Header="状态" Binding="{Binding Status,Mode=OneWay}" Width="110"/></DataGrid.Columns></DataGrid>
     <Border x:Name="EmptyLibrary" Background="{DynamicResource Canvas}" Padding="24"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"><TextBlock Text="{Binding Library.EmptyHeading,Mode=OneWay}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding Library.EmptyDescription,Mode=OneWay}" Foreground="{DynamicResource Secondary}" TextAlignment="Center" Margin="0,16,0,24"/><Button Content="添加电脑游戏目录" Command="{Binding Commands[AddLibrary]}" Style="{StaticResource Primary}" Visibility="{Binding Library.HasEntries,Converter={StaticResource Visible},ConverterParameter=not}"/><Button Content="清除筛选，查看游戏库" Command="{Binding Commands[ClearFilters]}" Style="{StaticResource Primary}" Visibility="{Binding Library.HasEntries,Converter={StaticResource Visible}}"/><Button Content="查看连接指引" Style="{StaticResource Quiet}" Margin="0,8,0,0" Command="{Binding Commands[Navigate]}" CommandParameter="diagnostics"/></StackPanel></Border>
    </Grid>
   </Grid>
   <local:SaveLibraryPage x:Name="SavesPage" Visibility="Collapsed"/>
   <local:CrossSavePage x:Name="CrossSavePage" Visibility="Collapsed"/>
   <local:ResourcesPage x:Name="ResourcesPage" Visibility="Collapsed"/>
   <!-- Explorer -->
   <Grid x:Name="FilesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button Content="↑" DockPanel.Dock="Left" Click="OnParentFolder" ToolTip="上级目录"/><WrapPanel x:Name="Breadcrumbs" MaxWidth="260" DockPanel.Dock="Left" VerticalAlignment="Center"/><TextBox x:Name="RemotePath" Text="/" KeyDown="OnPathKeyDown" Margin="8,0,0,0" AutomationProperties.Name="SD 路径"/></DockPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="上传" Command="{Binding Commands[UploadPick]}"/><Button Content="下载" Command="{Binding Commands[Download]}" Margin="8,0,0,0"/><Button Content="重命名" Command="{Binding Commands[Rename]}" Margin="8,0,0,0"/><Button Content="新建目录" Command="{Binding Commands[Mkdir]}" Margin="8,0,0,0"/><Button Content="删除" Command="{Binding Commands[Delete]}" Style="{StaticResource Quiet}" Margin="8,0,0,0"/></WrapPanel>
    <DataGrid x:Name="FilesGrid" Grid.Row="2" AllowDrop="True" DragOver="OnFileDragOver" Drop="OnUploadDrop" MouseDoubleClick="OnOpenRemote" PreviewMouseLeftButtonDown="OnFileMouseDown" PreviewMouseMove="OnFileMouseMove" SelectionChanged="OnCommandSelection"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="大小 / 类型" Binding="{Binding SizeText,Mode=OneWay}" Width="150"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="3" x:Name="FileTarget" Text="拖入此处 → SD 卡 / · 受保护路径会在操作前说明" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
   </Grid>
   <!-- LAN: FTP transfer and Homebrew store -->
   <Grid x:Name="NetworkPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button Content="连接" Command="{Binding Commands[FtpConnect]}"/><Button Content="断开" Command="{Binding Commands[FtpDisconnect]}" Margin="8,0,0,0" Style="{StaticResource Quiet}"/><TextBlock Text=" 主机" VerticalAlignment="Center" Margin="14,0,0,0"/><TextBox x:Name="FtpHost" Width="140" Margin="8,0,0,0" AutomationProperties.Name="FTP 主机地址"/><TextBlock Text="端口" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="FtpPort" Width="56" Margin="8,0,0,0" AutomationProperties.Name="FTP 端口"/><TextBlock Text="用户" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="FtpUser" Width="100" Margin="8,0,0,0" AutomationProperties.Name="FTP 用户名（可选）"/><TextBlock Text="密码" VerticalAlignment="Center" Margin="12,0,0,0"/><PasswordBox x:Name="FtpPassword" Width="100" Margin="8,0,0,0" AutomationProperties.Name="FTP 密码（仅本次会话）" ToolTip="仅本次会话使用，不写入配置"/><TextBlock x:Name="FtpStatus" Text="未连接 · 在 Switch 运行 ftpd / sys-ftpd 后即可无线传输" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/></DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="↑" DockPanel.Dock="Left" Click="OnFtpParent" ToolTip="上级目录"/><WrapPanel x:Name="FtpBreadcrumbs" MaxWidth="260" DockPanel.Dock="Left" VerticalAlignment="Center"/><TextBox x:Name="FtpPath" Text="/" KeyDown="OnFtpPathKeyDown" Margin="8,0,0,0" AutomationProperties.Name="FTP 路径"/></DockPanel>
    <WrapPanel Grid.Row="2" Margin="0,0,0,12"><Button Content="上传" Command="{Binding Commands[FtpUpload]}"/><Button Content="上传文件夹" Command="{Binding Commands[FtpUploadFolder]}" Margin="8,0,0,0"/><Button Content="下载" Command="{Binding Commands[FtpDownload]}" Margin="8,0,0,0"/><Button Content="重命名" Command="{Binding Commands[FtpRename]}" Margin="8,0,0,0"/><Button Content="新建目录" Command="{Binding Commands[FtpMkdir]}" Margin="8,0,0,0"/><Button Content="删除" Command="{Binding Commands[FtpDelete]}" Style="{StaticResource Quiet}" Margin="8,0,0,0"/></WrapPanel>
    <DataGrid x:Name="FtpGrid" Grid.Row="3" MouseDoubleClick="OnFtpOpen" SelectionChanged="OnCommandSelection"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="大小 / 类型" Binding="{Binding SizeText,Mode=OneWay}" Width="150"/></DataGrid.Columns></DataGrid>
    <Expander Grid.Row="4" Header="Homebrew 应用商店（社区免费开源软件 · 不含商业游戏）" Margin="0,12,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="从你配置的 JSON 索引浏览 Homebrew 应用，下载后写入 SD 卡 /switch/。仅收录免费开源内容；商业游戏请通过 eShop 或卡带获取。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,10,0,0"><Button Content="刷新索引" Command="{Binding Commands[HomebrewRefresh]}"/><Button Content="安装所选到 SD 卡" Command="{Binding Commands[HomebrewInstall]}" Margin="8,0,0,0"/></WrapPanel><ListBox x:Name="HomebrewList" ItemsSource="{Binding HomebrewApps,Mode=OneWay}" SelectedItem="{Binding SelectedHomebrew}" MaxHeight="170" Margin="0,12,0,0" SelectionChanged="OnCommandSelection"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Label,Mode=OneWay}"/><TextBlock Text="{Binding Detail,Mode=OneWay}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Expander>
   </Grid>
   <!-- Console -->
   <ScrollViewer x:Name="ConsolePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="当前主机" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Model,Mode=OneWay}" FontSize="24" Margin="0,12,0,4"/><TextBlock Text="{Binding EnvironmentText,Mode=OneWay}" Foreground="{DynamicResource Accent}"/><TextBlock Text="容量对应当前系统的用户分区；emuMMC 与真实系统分别记录。" Style="{StaticResource Muted}" Margin="0,12,0,24"/>
    <ItemsControl ItemsSource="{Binding Storages,Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="20" CornerRadius="9" Background="{DynamicResource Surface}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding Name,Mode=OneWay}" FontWeight="SemiBold"/><ProgressBar Value="{Binding UsedPercent,Mode=OneWay}" Margin="0,16,0,12"/><TextBlock Text="{Binding Summary,Mode=OneWay}" Style="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Background="{DynamicResource Surface}" Padding="20" CornerRadius="9" Margin="0,12,0,0"><StackPanel><TextBlock Text="系统与连接" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="{Binding Device.Firmware,Mode=OneWay,StringFormat=系统版本  {0}}" Margin="0,6"/><TextBlock Text="{Binding Device.Atmosphere,Mode=OneWay,StringFormat=Atmosphère  {0}}" Margin="0,6"/><TextBlock Text="{Binding Device.Companion,Mode=OneWay,StringFormat=配套程序  {0}}" Margin="0,6"/><TextBlock Text="{Binding Device.UsbSpeed,Mode=OneWay}" Margin="0,6"/></StackPanel></Border><Button Content="刷新主机资料" Command="{Binding Commands[Refresh]}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></ScrollViewer>
   <!-- Settings -->
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="外观" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="ThemeChoice" SelectedValuePath="Tag" SelectionChanged="OnThemeChoice" Margin="0,12,0,24" Width="240" HorizontalAlignment="Left"><ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox><TextBlock Text="更新内容来源" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="本地目录、Windows 已连接的 NAS，或自有 HTTP 索引。凭据不写入配置。" Style="{StaticResource Muted}" Margin="0,12"/><ListBox ItemsSource="{Binding ContentSources}" SelectedItem="{Binding SelectedSource}" MaxHeight="160" MinHeight="48"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Root}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Margin="0,12,0,24"><Button Content="添加来源" Command="{Binding Commands[AddContentSource]}"/><Button Content="从安装包生成索引" Command="{Binding Commands[BuildContentIndex]}" Margin="12,0,0,0"/><Button Content="移除来源" Command="{Binding Commands[RemoveContentSource]}" Margin="12,0,0,0"/></WrapPanel><Expander Header="精选游戏"><TextBlock Text="此环境的原生 HOME 隐藏与恢复尚未准入，暂不开放设置；主机显示保持原样。" Margin="0,12"/></Expander><TextBlock Text="文件与备份" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,0"/><TextBlock x:Name="SettingsSummary" Foreground="{DynamicResource Secondary}" Margin="0,12,0,16"/><Button Content="修改目录、播放器和保留数量" Click="OnSettings" HorizontalAlignment="Left"/><TextBlock Text="电脑游戏目录" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,12"/><TextBlock x:Name="LibraryLocation" Style="{StaticResource Muted}"/><WrapPanel Margin="0,12,0,0"><Button Content="添加目录" Command="{Binding Commands[AddLibrary]}"/><Button Content="扫描当前目录" Command="{Binding Commands[ScanLibrary]}" Margin="8,0,0,0"/><Button Content="批量校验" Command="{Binding Commands[VerifyAllLibrary]}" Margin="8,0,0,0"/><Button Content="清理缺失索引" Command="{Binding Commands[CleanMissing]}" Margin="8,0,0,0"/><Button Content="查找重复" Command="{Binding Commands[FindDupes]}" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="操作习惯" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,12"/><TextBlock Text="Ctrl+F 搜索 · Alt+1…7 切换页面 · 方向键选择游戏 · Enter 打开详情 · Esc 收起详情。动画遵循 Windows 系统设置。" Style="{StaticResource Muted}"/><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,28,0,12"><StackPanel><TextBlock Text="SwitchDesk" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="让游戏、存档与文件各就其位。" Style="{StaticResource Muted}" Margin="0,8,0,16"/><TextBlock Text="一生破晓" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/><TextBlock Text="在原 SwitchDesk 基础上改进 · GPL-3.0" Style="{StaticResource Muted}" Margin="0,5,0,12"/><Button Content="项目主页 ↗" HorizontalAlignment="Left" Style="{StaticResource Quiet}" Click="OnProjectHome"/></StackPanel></Border></StackPanel></ScrollViewer>
   <!-- Diagnostics -->
   <Grid x:Name="DiagnosticsPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><Button Content="重新连接" Command="{Binding Commands[Reconnect]}"/><Button Content="复制诊断信息" Click="OnCopyDiagnostics" Margin="8,0,0,0"/><Button Content="复制配套版本" Click="OnCopyCompanion" Margin="8,0,0,0"/><Button Content="打开完整日志" Click="OnRevealLogs" Margin="8,0,0,0"/><Button Content="核对上次操作" Command="{Binding Commands[InspectPending]}" Margin="8,0,0,0"/><Button Content="迁移保护副本" Command="{Binding Commands[OpenPhase2Recovery]}" Margin="8,0,0,0"/></WrapPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
     <Button x:Name="CheckDriverButton" Content="检查 USB 驱动" Click="OnCheckUsbDriver"/>
     <Button x:Name="BindWinUsbButton" Content="一键绑定 WinUSB" IsEnabled="False" Click="OnBindWinUsb" Margin="8,0,0,0"
      ToolTipService.ShowOnDisabled="True" ToolTip="检查后，仅可为唯一确认且缺少驱动的 SwitchDesk PC 接口绑定 WinUSB。Windows 将请求管理员权限。"/>
     <Button x:Name="ZadigButton" Content="打开 Zadig 官网 ↗" Click="OnOpenZadig" Margin="8,0,0,0"/>
     <Button x:Name="DeviceManagerButton" Content="打开设备管理器" Click="OnOpenDeviceManager" Margin="8,0,0,0"/>
    </WrapPanel>
    <TabControl x:Name="DiagnosticTabs" Grid.Row="2">
     <TabItem Header="任务"><Grid x:Name="QueuePanel" Margin="0,16,0,0">
      <TextBlock Text="暂无任务记录" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Tasks.HasItems,Converter={StaticResource Visible},ConverterParameter=not}"/>
      <DataGrid x:Name="JobsGrid" RowHeight="NaN" MinRowHeight="48" ItemsSource="{Binding Tasks.Items,Mode=OneWay}" SelectionChanged="OnCommandSelection" Visibility="{Binding Tasks.HasItems,Converter={StaticResource Visible}}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="时间" Binding="{Binding TimeText,Mode=OneWay}" Width="85"/>
        <DataGridTextColumn Header="任务" Binding="{Binding Name,Mode=OneWay}" Width="2*"/>
        <DataGridTemplateColumn Header="状态" Width="3*" ClipboardContentBinding="{Binding StateCopyText}"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="0,4">
         <TextBlock Text="{Binding State,Mode=OneWay}"/>
         <TextBlock Text="{Binding DiagnosticDetail,Mode=OneWay}" Foreground="{DynamicResource Secondary}" Margin="0,4,0,0" Visibility="{Binding HasDiagnosticDetail,Converter={StaticResource Visible}}"/>
         <ProgressBar Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding Indeterminate,Mode=OneWay}" Margin="0,8,0,4" Visibility="{Binding Active,Converter={StaticResource Visible}}"/>
         <TextBlock Text="{Binding ProgressText,Mode=OneWay}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Active}" Value="True"/><Condition Binding="{Binding Indeterminate}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn x:Name="JobActionsColumn" Header="操作" Width="140" Visibility="Collapsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
         <Button Content="取消" Command="{Binding DataContext.Commands[CancelJob],RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,3" MinHeight="28" Visibility="{Binding CanCancel,Converter={StaticResource Visible}}"/>
         <Button Content="重试" Command="{Binding DataContext.Commands[RetryJob],RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,3" MinHeight="28" Visibility="{Binding CanRetry,Converter={StaticResource Visible}}"/>
        </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid></TabItem>
     <TabItem Header="连接事件"><ListBox x:Name="LogList" ItemsSource="{Binding ConnectionEvents,Mode=OneWay}" Margin="0,16,0,0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/></TabItem>
     <TabItem x:Name="DriverTab" Header="USB 驱动指引"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,12,12,0">
      <TextBlock Text="本机驱动检查" FontWeight="SemiBold"/>
      <TextBlock x:Name="DriverReport" Text="点击“检查 USB 驱动”读取 Windows 当前的设备状态。" Foreground="{DynamicResource Accent}" Margin="0,6,0,14"/>
      <TextBlock Text="首次连接与错误 28" FontWeight="SemiBold"/>
      <TextBlock Text="先点“检查 USB 驱动”。若已确认缺驱动的是 SwitchDesk PC，点“一键绑定 WinUSB”并确认 Windows 管理员授权；完成后会自动复查。需要手动处理时按下列步骤操作。" Margin="0,8,0,0"/>
      <TextBlock Text="1. 在 Switch 打开 SwitchDesk 配套程序，用 USB 数据线连接电脑。在设备管理器中核对设备名称及硬件 ID，可拔插数据线观察同一接口消失和出现。" Margin="0,8,0,0"/>
      <TextBlock Text="2. 错误 28 表示 Windows 未为该设备安装驱动。打开 Zadig 官网，下载并运行 Zadig；菜单选择 Options → List All Devices。" Margin="0,8,0,0"/>
      <TextBlock Text="3. 选择 SwitchDesk PC，核对 USB ID 为 057E:3000，再核对选中的接口及左侧当前驱动。DBI 等模式也会使用这个 ID。仅凭 ID 无法确认时请先返回主机配套，切勿更改 USB 复合父设备或其他接口。" Margin="0,8,0,0"/>
      <TextBlock Text="4. 左侧已有 WinUSB 时直接返回并重新连接。确认目标接口缺少驱动后，右侧选择 WinUSB，点击 Install Driver。安装完成后重新连接，再检查驱动状态。" Margin="0,8,0,0"/>
      <TextBlock Text="接口被占用时，请先退出其他 USB 管理工具或播放器。存档、安装和导出需要在主机的完整应用模式下运行配套程序。" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
  </Grid>
 </Grid>
 <!-- Right game details -->
 <Border x:Name="Details" Grid.Row="1" Grid.Column="2" Margin="0,0,20,16" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Visibility="{Binding DetailOpen,Converter={StaticResource Visible}}">
 <Grid Margin="16,16,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><DockPanel><Button Content="×" Style="{StaticResource Quiet}" Padding="8,0" MinHeight="26" DockPanel.Dock="Right" ToolTip="收起详情 · Esc" Command="{Binding Commands[CloseDetails]}"/><TextBlock Text="游戏详情" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding Library.Selected.Name,Mode=OneWay}" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,8"/><TextBlock Text="{Binding Library.Selected.Publisher,Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,0,0,16"/></StackPanel>
 <TabControl x:Name="DetailsTabs" Grid.Row="1" SelectionChanged="OnDetailsTabChanged"><TabItem Header="内容"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Library.Selected.Status,Mode=OneWay}" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding Library.Selected.Summary,Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,8,0,20"/><TextBlock Text="主机中的内容" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Library.Selected.Components,Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center"><StackPanel><TextBlock Text="{Binding Name,Mode=OneWay}"/><TextBlock Text="{Binding Detail,Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></CheckBox><TextBlock Grid.Column="1" Text="{Binding SizeText,Mode=OneWay}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="更新与 DLC" FontWeight="SemiBold" Margin="0,24,0,8"/><TextBlock Text="{Binding UpdateSummary}" Style="{StaticResource Muted}"/><WrapPanel Margin="0,12,0,0"><Button Content="检查更新" Command="{Binding Commands[CheckUpdates]}"/><Button Content="添加来源" Command="{Binding Commands[AddContentSource]}" Margin="8,0,0,0"/></WrapPanel><ListBox ItemsSource="{Binding UpdateOffers}" SelectedItem="{Binding SelectedOffer}" MaxHeight="190" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding HasContent}" Content="{Binding Label}"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Secondary}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="下载当前条目到电脑" Command="{Binding Commands[DownloadOffer]}" Margin="0,8,0,0"/><ComboBox x:Name="UpdateStorage" SelectedValuePath="Tag" SelectedIndex="0" Margin="0,12,0,0" AutomationProperties.Name="更新清单目标存储"><ComboBoxItem Content="SD 卡" Tag="SdCard"/><ComboBoxItem Content="当前系统用户分区" Tag="BuiltInUser"/></ComboBox><Button Content="安装勾选清单…" Command="{Binding Commands[InstallOffer]}" Margin="0,8,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="需要已配置内容来源，并连接支持安装计划的新版配套程序"/>
 <TextBlock Text="电脑中的文件" FontWeight="SemiBold" Margin="0,24,0,12"/><ListBox x:Name="LocalFiles" ItemsSource="{Binding Library.Selected.Local,Mode=OneWay}" SelectedIndex="0" SelectionChanged="OnCommandSelection" MaxHeight="180"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name,Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Status,Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Content="校验" Command="{Binding Commands[VerifyLocal]}"/><Button Content="识别" Command="{Binding Commands[InspectLocal]}" Margin="8,0,0,0"/><Button Content="位置" Command="{Binding Commands[RevealLocal]}" Style="{StaticResource Quiet}"/></WrapPanel><Expander Header="技术信息"><StackPanel Margin="0,8"><TextBlock Text="{Binding Library.Selected.TitleId,Mode=OneWay}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Library.Selected.Version,Mode=OneWay,StringFormat=版本 {0}}" Style="{StaticResource Muted}"/></StackPanel></Expander></StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,16,0,0"><Button x:Name="ExportButton" ToolTipService.ShowOnDisabled="True" ToolTip="需要连接支持内容导出的配套程序" Content="↓  导出所选到电脑" Command="{Binding Commands[Export]}"/><Button Content="安装到主机…" Command="{Binding Commands[InstallLocal]}" Margin="0,8,0,0" Style="{StaticResource Primary}" Visibility="{Binding Library.Selected.OnComputer,Converter={StaticResource Visible}}"/><Button Content="更改导出目录" Style="{StaticResource Quiet}" Command="{Binding Commands[ExportDirectory]}" Padding="8,6"/><TextBlock Text="分别导出 NSP 与元数据清单" Style="{StaticResource Muted}"/></StackPanel></Grid></TabItem>
 <TabItem Header="存档"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0"><TextBlock Text="用户" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Saves.Users,Mode=OneWay}" SelectedItem="{Binding Saves.Selected}" DisplayMemberPath="Label" Margin="0,8,0,16" AutomationProperties.Name="选择存档用户"/><Button ToolTipService.ShowOnDisabled="True" ToolTip="需要连接主机，并在完整应用模式下读取此用户存档" Content="立即备份" Command="{Binding Commands[Backup]}" Style="{StaticResource Primary}"/><TextBlock Text="当前存档 · 拖到资源管理器可备份" Margin="0,16,0,0" Padding="12" Background="{DynamicResource Subtle}" Cursor="Hand" PreviewMouseLeftButtonDown="OnSaveMouseDown" PreviewMouseMove="OnSaveMouseMove"/><CheckBox Style="{StaticResource Switch}" Content="连接后自动备份" IsChecked="{Binding Saves.AutoBackup}" IsEnabled="{Binding Saves.HasLive,Mode=OneWay}" Margin="0,20,0,4"/><TextBlock x:Name="RetentionLabel" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Saves.HistoryText,Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,8,0,24"/><DockPanel Margin="0,0,0,12"><Button Content="位置 ↗" Style="{StaticResource Quiet}" Padding="8,0" MinHeight="24" Click="OnRevealBackup" DockPanel.Dock="Right"/><TextBlock Text="历史版本" FontWeight="SemiBold"/></DockPanel><ListBox x:Name="SnapshotsGrid" ItemsSource="{Binding Saves.History,Mode=OneWay}" MaxHeight="400" SelectionChanged="OnCommandSelection" PreviewMouseLeftButtonDown="OnHistoryMouseDown" PreviewMouseMove="OnHistoryMouseMove"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="2,0,0,0" Padding="12,8" Margin="0,2,0,4"><StackPanel><DockPanel><Button Content="恢复" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Padding="6,0" MinHeight="22" Command="{Binding DataContext.Commands[RestoreVersion],RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding TimeText,Mode=OneWay}" FontSize="13"/></DockPanel><TextBlock Text="{Binding SizeText,Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Margin="0,12,0,0"><Button Content="恢复所选版本…" Command="{Binding Commands[Restore]}"/><Button Content="校验快照" Command="{Binding Commands[VerifySnapshot]}" Style="{StaticResource Quiet}" Margin="8,0,0,0"/><Button Content="对比所选…" Command="{Binding Commands[CompareSnapshot]}" Style="{StaticResource Quiet}" Margin="8,0,0,0"/><Button Content="导出所选…" Command="{Binding Commands[ExportSnapshot]}" Style="{StaticResource Quiet}" Margin="8,0,0,0"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="跨平台"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0"><TextBlock Text="换个平台，继续游玩" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="比较 Steam 与 Switch 的有效存档，保留两端快照，再选择迁移方向。" Margin="0,12,0,20" Foreground="{DynamicResource Secondary}"/><Button Content="打开双端比较" Command="{Binding Commands[CrossSaveOpen]}" Style="{StaticResource Primary}"/><TextBlock Text="每款游戏按版本独立适配；识别格式后仍需匹配支持清单。" Style="{StaticResource Muted}" Margin="0,16,0,0"/></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="金手指"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0"><TextBlock Text="EdiZon 金手指" FontWeight="SemiBold"/><TextBlock Text="从 /atmosphere/contents/&lt;TitleID&gt;/cheats/ 读取；只有该目录可写，Atmosphere 其他内容保持保护。标准 TXT 导入需要配套声明 cheats.text.v1；旧 .cheat 文件仍可管理。" Style="{StaticResource Muted}" Margin="0,8,0,16"/><WrapPanel><Button Content="刷新列表" Command="{Binding Commands[CheatRefresh]}"/><Button Content="导入文件夹…" Command="{Binding Commands[CheatImport]}" Margin="8,0,0,0"/><Button Content="启用 / 停用" Command="{Binding Commands[CheatToggle]}" Margin="8,0,0,0"/><Button Content="删除" Command="{Binding Commands[CheatDelete]}" Style="{StaticResource Quiet}" Margin="8,0,0,0"/></WrapPanel><ListBox x:Name="CheatsList" ItemsSource="{Binding Cheats,Mode=OneWay}" SelectionChanged="OnCommandSelection" MaxHeight="340" Margin="0,16,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="4,8"><StackPanel><TextBlock Text="{Binding FileName,Mode=OneWay}"/><TextBlock Text="{Binding StateText,Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="启用状态通过添加或去掉 .off 切换；导入 &lt;构建ID&gt;.txt（兼容 .cheat），目标采用标准 .txt。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>
 </TabControl></Grid></Border>
 <!-- Installation review, single commit for the batch -->
 <Border x:Name="InstallOverlay" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource Canvas}" Padding="28" Visibility="Collapsed">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button Content="关闭清单" DockPanel.Dock="Right" Click="OnCloseInstall"/><StackPanel><TextBlock Text="整理安装清单" Style="{StaticResource Heading}"/><TextBlock x:Name="InstallContext" Style="{StaticResource Muted}"/><CheckBox x:Name="InstallHashCompatibility" Content="兼容转换包（签名与摘要差异以警告显示）" IsChecked="True" Margin="0,8,0,0" ToolTip="需要支持签名与摘要警告的新版配套；取消勾选将严格校验 NCA 签名与摘要"/></StackPanel></DockPanel>
   <DockPanel Grid.Row="1" Margin="0,24,0,16"><ComboBox x:Name="InstallStorage" Width="190" DockPanel.Dock="Left" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="OnInstallStorage"><ComboBoxItem Content="SD 卡" Tag="SdCard"/><ComboBoxItem Content="当前系统用户分区" Tag="BuiltInUser"/></ComboBox><TextBlock x:Name="InstallSummary" Margin="16,0,0,0" VerticalAlignment="Center"/></DockPanel>
   <DataGrid x:Name="InstallGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="文件" Binding="{Binding Name,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="组件与预计空间" Binding="{Binding Detail,Mode=OneWay}" Width="2*"/><DataGridTextColumn Header="状态" Binding="{Binding State,Mode=OneWay}" Width="190"/></DataGrid.Columns></DataGrid>
   <StackPanel Grid.Row="3" Margin="0,20,0,0">
    <Border x:Name="InstallWarningsPanel" Background="{DynamicResource Subtle}" Padding="12" CornerRadius="7" Margin="0,0,0,12" Visibility="{Binding SelectedItem.HasWarnings,ElementName=InstallGrid,Converter={StaticResource Visible}}">
     <StackPanel><DockPanel><Button Content="复制校验提示" Click="OnCopyInstallWarnings" DockPanel.Dock="Right" Margin="12,0,0,6"/><TextBlock Text="所选文件的安装校验提示" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="InstallWarningText" Text="{Binding SelectedItem.WarningText,ElementName=InstallGrid}"/></ScrollViewer></StackPanel>
    </Border>
    <TextBlock x:Name="InstallError" Foreground="{DynamicResource Error}" Margin="0,0,0,12" ToolTip="右键复制完整错误信息"/>
    <WrapPanel><Button x:Name="StartInstall" Content="开始安装" Style="{StaticResource Primary}" Click="OnStartInstall"/><Button x:Name="RetryInstall" Content="重试并继续" Margin="12,0,0,0" Click="OnRetryInstall" Visibility="Collapsed"/><Button x:Name="SkipInstall" Content="跳过失败项并继续" Margin="12,0,0,0" Click="OnSkipInstall" Visibility="Collapsed"/><Button Content="重新识别清单" Margin="12,0,0,0" Click="OnReviewAgain"/><Button Content="复制安装信息" Margin="12,0,0,0" Click="OnCopyInstallInfo"/></WrapPanel>
   </StackPanel>
  </Grid>
 </Border>
 <Border x:Name="UploadOverlay" Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource Canvas}" Padding="28" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button Content="关闭" DockPanel.Dock="Right" Click="OnCloseUpload"/><StackPanel><TextBlock Text="复制到 SD 卡" Style="{StaticResource Heading}"/><TextBlock x:Name="UploadContext"/></StackPanel></DockPanel><DataGrid x:Name="UploadGrid" Grid.Row="1" Margin="0,20" IsReadOnly="False"><DataGrid.Columns><DataGridTextColumn Header="电脑文件" Binding="{Binding Name,Mode=OneWay}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="目标名称（可修改）" Binding="{Binding TargetName,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Hint,Mode=OneWay}" IsReadOnly="True" Width="*"/><DataGridCheckBoxColumn Header="跳过" Binding="{Binding Skip,UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="开始复制" HorizontalAlignment="Left" Style="{StaticResource Primary}" Click="OnCommitUpload"/></Grid></Border>
 <Border x:Name="StreamOverlay" Grid.RowSpan="3" Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource Canvas}" Padding="28" Visibility="{Binding StreamGuide,Converter={StaticResource Visible}}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18"><Button Content="停止并返回" Command="{Binding Commands[CloseStream]}" DockPanel.Dock="Right" Margin="16,0,0,0"/><StackPanel><TextBlock Text="USB 游戏投屏" Style="{StaticResource Heading}"/><TextBlock x:Name="StreamRuntimeLabel" Text="内置 SysDVR 6.3 · USB 数据线 · 720p / 30fps" Style="{StaticResource Muted}"/></StackPanel></DockPanel>
   <Border Grid.Row="1" Background="#10151D" CornerRadius="9" ClipToBounds="True" MinHeight="220"><Grid x:Name="StreamVideoArea">
    <local:NativeVideoHost x:Name="StreamVideoHost" Visibility="Collapsed" Focusable="False"/>
    <StackPanel x:Name="StreamIdlePanel" MaxWidth="610" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
     <TextBlock x:Name="StreamViewportHeading" Text="一根 USB 线，在这里看游戏画面" Foreground="#F0F4FA" FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/>
     <TextBlock x:Name="StreamViewportHint" Text="电脑客户端已随完整运行包提供，无需另行选择路径。&#10;首次使用还需在 Switch 上启用 SysDVR USB 模式。" Foreground="#ADBBD0" TextAlignment="Center" Margin="0,16,0,0" LineHeight="25"/>
    </StackPanel>
   </Grid></Border>
   <StackPanel Grid.Row="2" Margin="0,18,0,0">
    <TextBlock x:Name="StreamStatusText" Text="准备就绪 · 请在主机打开支持录像的游戏" FontWeight="SemiBold"/>
    <TextBlock x:Name="StreamCondition" Foreground="{DynamicResource Error}" Margin="0,6,0,0"/>
    <WrapPanel Margin="0,13,0,0"><Button x:Name="StartStreamButton" Content="开始投屏" Command="{Binding Commands[Stream]}" Style="{StaticResource Primary}"/><Button x:Name="StopStreamButton" Content="停止投屏" Command="{Binding Commands[StopStream]}" Margin="10,0,0,0"/><CheckBox x:Name="StreamAudioEnabled" Content="播放声音" IsChecked="True" VerticalAlignment="Center" Margin="18,0,0,0"/></WrapPanel>
    <Expander Header="首次使用与适用范围" Margin="0,14,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="1. 将随包提供的 Switch 端文件放入 SD 卡并重启，按说明配置 Windows USB 驱动。&#10;2. 点击开始投屏释放管理连接，在主机 SysDVR 设置中选择 USB，再打开兼容游戏。&#10;3. 返回管理前，在主机 SysDVR 设置中选择“停止串流”，然后重新打开 SwitchDesk 配套。" Style="{StaticResource Muted}"/><TextBlock Text="当前方案显示兼容游戏的画面与声音；HOME、系统设置和相册模式界面不在采集范围内。停止电脑播放器不会自动关闭主机的 USB 投屏模式。" Style="{StaticResource Muted}" Margin="0,8,0,0"/><WrapPanel Margin="0,10,0,0"><Button Content="打开 Switch 端安装文件" Click="OnOpenStreamingSetup"/><Button Content="官方配置说明 ↗" Click="OnSysDvrHelp" Style="{StaticResource Quiet}" Margin="10,0,0,0"/></WrapPanel></StackPanel></Expander>
   </StackPanel>
  </Grid>
 </Border>
</Grid></Window>
