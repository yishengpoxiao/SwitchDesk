<Window x:Class="SwitchDesk.App.DbiInstallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="通过 DBI 安装" Width="900" Height="710" MinWidth="700" MinHeight="600" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" Closing="OnClosing">
 <Border Padding="24" Background="{DynamicResource Canvas}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="通过 DBI 安装" Style="{StaticResource Heading}"/><TextBlock x:Name="ConsoleLaunchStatus" TextWrapping="Wrap" Text="SwitchDesk 管理连接已暂停，安装由主机上的 DBI 执行。" Foreground="{DynamicResource Accent}"/><TextBlock Text="1. 看到主机 DBI 后，进入 Install title from DBIbackend（通常按 Y）；若尚未打开，请在主机启动 DBI。&#xA;2. 添加电脑中的安装包，再启动 DBI 后端。&#xA;3. 在 DBI 中选择游戏、安装位置并确认。" Margin="0,12,0,0" LineHeight="23"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,18,0,14"><TextBlock Text="电脑端 DBI 后端" FontWeight="SemiBold" Margin="0,0,0,7"/><DockPanel><Button x:Name="ChooseBackend" Content="选择后端…" DockPanel.Dock="Right" Click="OnChooseBackend" Margin="8,0,0,0"/><TextBox x:Name="BackendPath" ToolTip="选择自备 dbibackend.exe，或下载官方后端；留空时点击启动将下载官方版本" VerticalContentAlignment="Center"/></DockPanel><WrapPanel Margin="0,8,0,0"><Button x:Name="DownloadBackend" Content="下载官方后端 912ru" Click="OnDownloadBackend"/><TextBlock Text="仅点击下载或启动后访问官方来源，并核对 SHA-256。" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel></StackPanel>
  <DockPanel Grid.Row="2" Margin="0,0,0,8"><WrapPanel DockPanel.Dock="Right"><Button x:Name="AddPackages" Content="添加安装包…" Click="OnAddPackages"/><Button x:Name="ClearPackages" Content="清空" Click="OnClearPackages" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="FileSummary" Text="尚未选择安装包" VerticalAlignment="Center"/></DockPanel>
  <ListBox x:Name="PackageList" Grid.Row="3" SelectionMode="Extended" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Surface}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" Margin="0,3,0,0"/><TextBlock Text="{Binding Verification}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="准备就绪；选择文件不会开始安装。" Foreground="{DynamicResource Accent}"/><ProgressBar x:Name="OperationProgress" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/><TextBlock Text="后端会话结束不代表安装成功。安装进度和结果请在 Switch 的 DBI 中核对；会话期间请保留此窗口，结束时关闭外部 DBI 后端窗口。" Style="{StaticResource Muted}" Margin="0,9,0,12"/><DockPanel><Button Content="返回 SwitchDesk" DockPanel.Dock="Right" Click="OnReturn"/><Button x:Name="StartBackend" Content="启动 DBI 后端" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="OnStartBackend" IsEnabled="False"/></DockPanel></StackPanel>
 </Grid></Border>
</Window>
